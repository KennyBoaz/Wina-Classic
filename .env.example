# Copy this file to .env and fill in the values.
#   copy .env.example .env

# Meta WhatsApp Cloud API access token (from the Meta Developer dashboard)
WHATSAPP_TOKEN=

# Phone number ID shown next to your WhatsApp test/production number
WHATSAPP_PHONE_NUMBER_ID=

# Any secret string you choose. You will paste the SAME value into
# the Meta webhook "Verify token" field.
WEBHOOK_VERIFY_TOKEN=

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash if omitted.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Gemini 3.x reasoning depth: low, medium, or high.
# Default low (faster WhatsApp replies). API default without this is medium.
# GEMINI_THINKING_LEVEL=low

# Optional. Defaults to 3000 if omitted.
PORT=3000

BUSINESS_HOURS=mon-sat 08:00-20:00; sun 10:00-16:00
APPOINTMENT_SLOT_MINUTES=30
DELIVERY_INFO=your delivery answer here
PAYMENT_INFO=your payment answer here
RETURNS_INFO=your returns answer here